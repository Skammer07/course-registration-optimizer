# Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Replace <username>, <password>, and <cluster> with your Atlas credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/course-registration?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
# Use a long, random string (e.g. openssl rand -hex 64). Production requires >= 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=15m

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of your frontend dev server (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max login attempts per window (default: 10).
RATE_LIMIT_LOGIN_MAX=10
# Window in milliseconds (default: 15 minutes).
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# General API limit per client IP (login has its own stricter limit above).
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MS=60000
# Number of reverse proxies in front of the app (0 = none). Set to 1 behind one proxy/load balancer.
TRUST_PROXY=0

# Hard time limit for one allocation run (worker thread is terminated after this).
ALLOCATION_TIMEOUT_MS=60000
# Optional password for logins created by `npm run seed -- --users` (random if unset).
# SEED_STUDENT_PASSWORD=

# ── Seed Admin (development only) ────────────────────────────────────────────
# Used ONLY in NODE_ENV=development to create the first admin account.
# Remove or leave blank in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

