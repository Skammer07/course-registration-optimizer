{
  "info": {
    "_postman_id": "course-registration-api-v1",
    "name": "Course Registration Optimization API",
    "description": "Postman collection for the IIT (ISM) Dhanbad Course Registration Optimization backend.\n\nSet the `baseUrl` variable before use. Authentication uses HTTP-only cookies managed automatically by Postman (log in once per role; use a separate Postman cookie jar / environment to be admin and student at the same time).\n\nTypical workflow (admin): Auth > Login, then (if the account has a temporary password) Auth > Change Password; Semesters > Create; Imports > students / courses / preferences (try dryRun first); Allocations > Run Allocation Comparison; Allocations > Run summary / Results by student / by course; Allocations > Publish. Student: Login, Change Password, Semesters > My semester status, Preferences > Submit, Allocations > My results (after publish).\n\nEvery response has an X-Request-Id header; error bodies include requestId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "semesterId",
      "value": "SEM2026A",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "courseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "runIdB",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "new.user@example.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "No login needed. Reports database and algorithm availability, algorithm version, uptime and the number of allocation runs computing right now. 503 if the database or the algorithm package is unavailable."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@example.com\", \"password\": \"your_password_here\"}"
            },
            "description": "Authenticates the user. Sets a secure HTTP-only cookie on success."
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Returns the currently authenticated user. Requires cookie."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Clears the authentication cookie."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/change-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"the_temporary_or_current_password\",\n  \"newPassword\": \"a-new-password-of-8-to-128-chars\"\n}"
            },
            "description": "Any logged-in user. Required first when the account has a temporary password (mustChangePassword): until then every other route returns 403 PASSWORD_CHANGE_REQUIRED. Sets a fresh cookie and invalidates older tokens. Wrong current password: 400 INVALID_CURRENT_PASSWORD."
          }
        },
        {
          "name": "Login - Invalid Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@example.com\", \"password\": \"wrong\"}"
            }
          }
        },
        {
          "name": "Login - Missing Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"password\": \"somepassword\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Users (Admin)",
      "item": [
        {
          "name": "Create user - temporary password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"role\": \"faculty\"\n}"
            },
            "description": "Omit password: the server returns a one-time temporaryPassword in the response (shown once, never stored in plain text). The user must change it at first login. For role student add \"studentId\"."
          }
        },
        {
          "name": "Create user - admin sets password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"other.user@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"faculty\"\n}"
            },
            "description": "Legacy form: the admin chooses the password (8-128 chars). No temporary password is returned."
          }
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users?role=faculty&isActive=true&search=example&page=1&limit=50",
            "description": "Filters: role, isActive, search (email), page, limit (max 200). Never returns password data."
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/{{userId}}"
          }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users/{{userId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "description": "Takes effect on the user's very next request. You cannot deactivate yourself or the last active admin (409)."
          }
        },
        {
          "name": "Reactivate user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users/{{userId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/{{userId}}/reset-password",
            "description": "Returns a new one-time temporaryPassword, forces a change at next login and invalidates the user's existing sessions. Not allowed on your own account."
          }
        }
      ]
    },
    {
      "name": "Semesters",
      "item": [
        {
          "name": "Create semester",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/semesters",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"semesterId\": \"{{semesterId}}\",\n  \"name\": \"Autumn 2026\",\n  \"preferencesOpenAt\": \"2026-07-01T00:00:00.000Z\",\n  \"preferencesCloseAt\": \"2026-07-15T18:00:00.000Z\"\n}"
            },
            "description": "Admin. Dates are optional (a missing bound is unbounded). A semester with no record counts as open."
          }
        },
        {
          "name": "List semesters",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/semesters",
            "description": "Admin/faculty."
          }
        },
        {
          "name": "Semester overview (what has data)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/semesters/overview",
            "description": "Admin/faculty. Every semester that has data or an admin record, with counts of active students, active courses, submitted preference lists and runs. Used by the New run screen to offer a list instead of a typed id. Data from the seed script or CSV imports appears even without a semester record."
          }
        },
        {
          "name": "Course demand (how many ranked each course)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/semesters/{{semesterId}}/demand",
            "description": "Admin/faculty. For every course of the semester: how many submitted preference lists rank it, and how many rank it first and second. Courses nobody ranked are included with zeros."
          }
        },
        {
          "name": "Update semester dates",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/semesters/{{semesterId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preferencesCloseAt\": \"2026-07-20T18:00:00.000Z\"\n}"
            },
            "description": "Admin. null clears a date; close must be after open."
          }
        },
        {
          "name": "Open preferences now",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/semesters/{{semesterId}}/preferences-state",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"open\"\n}"
            },
            "description": "Admin. state: open | closed | auto (auto follows the dates). Publishing a run closes preferences automatically."
          }
        },
        {
          "name": "Close preferences now",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/semesters/{{semesterId}}/preferences-state",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"closed\"\n}"
            }
          }
        },
        {
          "name": "Back to the dates (auto)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/semesters/{{semesterId}}/preferences-state",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"auto\"\n}"
            }
          }
        },
        {
          "name": "Semester status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/semesters/{{semesterId}}/status",
            "description": "Any logged-in user. status: preferences-not-open | preferences-open | allocation-pending | results-published."
          }
        },
        {
          "name": "My semester status (student)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/semesters/me/status",
            "description": "Student only: 'me' resolves to the logged-in student's semester."
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "List Students (Admin/Faculty only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/students?semesterId={{semesterId}}&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students"
              ],
              "query": [
                {
                  "key": "semesterId",
                  "value": "{{semesterId}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Requires admin or faculty role. Students cannot enumerate the full student list (returns 403)."
          }
        },
        {
          "name": "Get Student by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/students/{{studentId}}"
          }
        },
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/students",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"20JE0001\",\n  \"name\": \"Aarav Kumar\",\n  \"cgpa\": 9.5,\n  \"department\": \"CSE\",\n  \"semesterId\": \"{{semesterId}}\",\n  \"electiveGroups\": [\"A\"]\n}"
            }
          }
        },
        {
          "name": "Update Student",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/students/{{studentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"cgpa\": 9.2}"
            }
          }
        },
        {
          "name": "Deactivate Student",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/students/{{studentId}}"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses?semesterId={{semesterId}}&isActive=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses"
              ],
              "query": [
                {
                  "key": "semesterId",
                  "value": "{{semesterId}}"
                },
                {
                  "key": "isActive",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Get Course by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/courses/{{courseId}}"
          }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/courses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseCode\": \"CS301\",\n  \"title\": \"Data Structures\",\n  \"capacity\": 60,\n  \"semesterId\": \"{{semesterId}}\",\n  \"electiveGroup\": \"A\",\n  \"timetableSlots\": [{\"day\": \"Monday\", \"start\": \"09:00\", \"end\": \"09:50\"}]\n}"
            }
          }
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/courses/{{courseId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"capacity\": 65}"
            }
          }
        },
        {
          "name": "Deactivate Course",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/courses/{{courseId}}"
          }
        }
      ]
    },
    {
      "name": "Imports (Admin, CSV)",
      "item": [
        {
          "name": "Import students - dry run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/csv"
              }
            ],
            "url": "{{baseUrl}}/api/v1/imports/students?dryRun=true",
            "body": {
              "mode": "raw",
              "raw": "studentId,name,cgpa,department,semesterId,electiveGroups,email\nIMP001,Asha Rao,9.1,CSE,{{semesterId}},A;B,imp001@example.com\nIMP002,Ravi Kumar,8.4,ECE,{{semesterId}},A;B,imp002@example.com\n"
            },
            "description": "Body is the CSV (Content-Type text/csv, max 2 MB / 5000 rows). dryRun=true validates and reports; nothing is written. Any problem returns 422 with {row, column, message}."
          }
        },
        {
          "name": "Import students (skip existing)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/csv"
              }
            ],
            "url": "{{baseUrl}}/api/v1/imports/students",
            "body": {
              "mode": "raw",
              "raw": "studentId,name,cgpa,department,semesterId,electiveGroups,email\nIMP001,Asha Rao,9.1,CSE,{{semesterId}},A;B,imp001@example.com\nIMP002,Ravi Kumar,8.4,ECE,{{semesterId}},A;B,imp002@example.com\n"
            },
            "description": "onExisting=skip is the default."
          }
        },
        {
          "name": "Import students + create logins",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/csv"
              }
            ],
            "url": "{{baseUrl}}/api/v1/imports/students?createLogins=true",
            "body": {
              "mode": "raw",
              "raw": "studentId,name,cgpa,department,semesterId,electiveGroups,email\nIMP001,Asha Rao,9.1,CSE,{{semesterId}},A;B,imp001@example.com\nIMP002,Ravi Kumar,8.4,ECE,{{semesterId}},A;B,imp002@example.com\n"
            },
            "description": "Needs an email column. Each new student gets a login with a one-time temporary password, returned once in data.credentials and data.credentialsCsv (save it now). Max 500 logins per import."
          }
        },
        {
          "name": "Import students (update existing)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/csv"
              }
            ],
            "url": "{{baseUrl}}/api/v1/imports/students?onExisting=update",
            "body": {
              "mode": "raw",
              "raw": "studentId,name,cgpa\nIMP001,Asha Rao,9.2\n"
            },
            "description": "Empty cells never overwrite existing values."
          }
        },
        {
          "name": "Import courses",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/csv"
              }
            ],
            "url": "{{baseUrl}}/api/v1/imports/courses",
            "body": {
              "mode": "raw",
              "raw": "courseCode,title,capacity,semesterId,electiveGroup,timetable\nIMPA1,Algorithms,30,{{semesterId}},A,Monday 09:00-10:00; Wednesday 09:00-10:00\nIMPA2,Machine Learning,30,{{semesterId}},A,Tuesday 09:00-10:00\nIMPB1,Databases,30,{{semesterId}},B,Thursday 11:00-12:00\n"
            },
            "description": "timetable cell: slots separated by ';', like 'Monday 09:00-10:00' (full or 3-letter weekday). Courses are identified by courseCode + semesterId."
          }
        },
        {
          "name": "Import preferences",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/csv"
              }
            ],
            "url": "{{baseUrl}}/api/v1/imports/preferences?status=submitted",
            "body": {
              "mode": "raw",
              "raw": "studentId,semesterId,electiveGroup,courseCode,rank\nIMP001,{{semesterId}},A,IMPA1,1\nIMP001,{{semesterId}},A,IMPA2,2\nIMP002,{{semesterId}},A,IMPA2,1\nIMP002,{{semesterId}},A,IMPA1,2\n"
            },
            "description": "One row per ranked course; the list order is the rank order. Checked like a student submission (active student, right semester and group, course exists and is in that group). Bypasses the preference deadline."
          }
        }
      ]
    },
    {
      "name": "Preferences",
      "item": [
        {
          "name": "Get My Preferences",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/preferences/me?semesterId={{semesterId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "preferences",
                "me"
              ],
              "query": [
                {
                  "key": "semesterId",
                  "value": "{{semesterId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Submit My Preferences",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/preferences/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"semesterId\": \"{{semesterId}}\",\n  \"electiveGroup\": \"A\",\n  \"rankedCourseIds\": [\"<course-object-id-1>\", \"<course-object-id-2>\"],\n  \"status\": \"submitted\"\n}"
            }
          }
        },
        {
          "name": "List All Preferences (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/preferences?semesterId={{semesterId}}&status=submitted",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "preferences"
              ],
              "query": [
                {
                  "key": "semesterId",
                  "value": "{{semesterId}}"
                },
                {
                  "key": "status",
                  "value": "submitted"
                }
              ]
            }
          }
        },
        {
          "name": "Preference progress per student (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/preferences/overview?semesterId={{semesterId}}&status=incomplete&page=1&limit=25",
            "description": "Admin/faculty. Every student of the semester with their submission state per elective group (submitted / draft / missing / na) and an overall status (complete / incomplete / none), plus totals. Filters: search, department, status, includeInactive."
          }
        },
        {
          "name": "One student's preference lists (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/preferences?student={{studentId}}&semesterId={{semesterId}}",
            "description": "Admin/faculty. The lists of one student (their _id, from the student list), each with its ranked courses."
          }
        }
      ]
    },
    {
      "name": "Allocations",
      "item": [
        {
          "name": "Run Allocation Comparison",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/allocations/compare",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"semesterId\": \"{{semesterId}}\",\n  \"maxCoursesPerStudent\": 2,\n  \"meritRatio\": 0.75,\n  \"randomRatio\": 0.25,\n  \"includeTimetable\": true,\n  \"seed\": 12345\n}"
            },
            "description": "Admin only. Loads data from DB, runs both algorithms, persists the run. meritRatio + randomRatio must equal exactly 1.0 (e.g. 0.75 + 0.25; 0/1 and 1/0 are valid). Returns 400 otherwise. Optional seed (integer) makes the baseline lottery reproducible; it is stored on the run."
          }
        },
        {
          "name": "Run ONE algorithm - baseline",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/allocations/run",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"semesterId\": \"{{semesterId}}\",\n  \"algorithm\": \"baseline\",\n  \"maxCoursesPerStudent\": 2,\n  \"meritRatio\": 0.75,\n  \"randomRatio\": 0.25,\n  \"includeTimetable\": true,\n  \"seed\": 12345\n}"
            },
            "description": "Admin only. Runs only the baseline (merit + random). meritRatio/randomRatio must sum to 1; seed makes the lottery reproducible."
          }
        },
        {
          "name": "Run ONE algorithm - optimized",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/allocations/run",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"semesterId\": \"{{semesterId}}\",\n  \"algorithm\": \"optimized\",\n  \"maxCoursesPerStudent\": 2,\n  \"includeTimetable\": true\n}"
            },
            "description": "Admin only. Runs only the min-cost max-flow optimizer. Ratios and seed are not accepted for the optimizer."
          }
        },
        {
          "name": "Compare two runs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/allocations/runs/compare?runA={{runId}}&runB={{runIdB}}",
            "description": "Admin/faculty. Side-by-side metrics and differences (B minus A). Add algorithmA/algorithmB for runs that contain both algorithms. Warnings flag differing input data."
          }
        },
        {
          "name": "List Allocation Runs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/allocations/runs?semesterId={{semesterId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "allocations",
                "runs"
              ],
              "query": [
                {
                  "key": "semesterId",
                  "value": "{{semesterId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Allocation Run",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/allocations/runs/{{runId}}"
          }
        },
        {
          "name": "My results (student)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/allocations/my-results",
            "description": "Student only. The logged-in student's own PUBLISHED assignments (course, preference rank, phase). Before publishing: published=false and an empty list."
          }
        },
        {
          "name": "Published run of a semester",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/allocations/published?semesterId={{semesterId}}",
            "description": "Any logged-in user. Which run/algorithm is published. Students may only ask about their own semester."
          }
        },
        {
          "name": "Run summary (dashboard)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/allocations/runs/{{runId}}/summary",
            "description": "Admin/faculty. Both algorithms side by side: metrics, validation, runtimes, policy details and differences (optimized minus baseline). No winner is declared."
          }
        },
        {
          "name": "Results by student",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/allocations/runs/{{runId}}/results/by-student?algorithm=baseline&status=all&sort=cgpa&search=&page=1&limit=50",
            "description": "One row per student including unallocated ones. status: all|allocated|unallocated; sort: studentId|name|cgpa|coursesAllocated|averageRank. algorithm may be omitted when the run is published."
          }
        },
        {
          "name": "Results by course",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/allocations/runs/{{runId}}/results/by-course?algorithm=baseline&sort=utilization&includeStudents=true",
            "description": "One row per course: capacity, seats filled, utilization, demand, phase split and (optionally) students."
          }
        },
        {
          "name": "Export run as CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/allocations/runs/{{runId}}/export?algorithm=baseline",
            "description": "Admin/faculty. CSV attachment, one row per assignment. In Postman use Send and Download."
          }
        },
        {
          "name": "Get Run Results",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/allocations/runs/{{runId}}/results?algorithm=baseline&phase=merit&rank=1&sort=-rank&page=1&limit=100",
            "description": "Admin/faculty. Raw assignment rows. Optional filters: algorithm, phase (merit|random), rank, courseCode, studentId; sort = default | rank | -rank | phase."
          }
        },
        {
          "name": "Publish Allocation Run (optimized)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/allocations/runs/{{runId}}/publish",
            "body": {
              "mode": "raw",
              "raw": "{\"algorithm\": \"optimized\"}"
            },
            "description": "Admin only. Publishes the optimized algorithm's assignments for the run. Only the selected algorithm's records are marked published; the baseline records remain available for comparison. The stored assignments are re-validated first (422 PUBLICATION_VALIDATION_FAILED on any violation). Switching the algorithm after an initial publish, or losing a concurrent publish race, returns 409 Conflict; repeating the same algorithm is idempotent."
          }
        },
        {
          "name": "Publish Allocation Run (baseline)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/allocations/runs/{{runId}}/publish",
            "body": {
              "mode": "raw",
              "raw": "{\"algorithm\": \"baseline\"}"
            },
            "description": "Admin only. Publishes the baseline algorithm's assignments for the run. Use this variant to officially release the baseline results instead of the optimized ones."
          }
        },
        {
          "name": "Publish Allocation Run - Missing algorithm (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/allocations/runs/{{runId}}/publish",
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Demonstrates that omitting the 'algorithm' field returns 400 Bad Request."
          }
        },
        {
          "name": "Verify run (replay)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/allocations/runs/{{runId}}/verify",
            "description": "Admin. Re-runs the algorithm(s) from the stored snapshot (baseline: stored seed and ratios) and compares with the stored assignments. Add ?algorithm=baseline|optimized for one."
          }
        },
        {
          "name": "Cancel a running run",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/allocations/runs/{{runId}}/cancel",
            "description": "Admin. Only for status running. The run becomes cancelled; the request that started it answers 409 ALLOCATION_CANCELLED."
          }
        },
        {
          "name": "Delete a run",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/allocations/runs/{{runId}}",
            "description": "Admin. Only completed, failed or cancelled runs; published runs are kept for audit (409)."
          }
        }
      ]
    }
  ]
}
