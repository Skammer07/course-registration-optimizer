# Frontend environment (copy to .env.local to change anything; none of this is required in development)

# Where the dev server forwards /api and /health. Default: http://localhost:5000
# VITE_DEV_API_TARGET=http://localhost:5000

# Base URL of the API for a production build served from a different origin than the API.
# Leave empty when the site and the API share one origin (the usual reverse-proxy setup).
# If you set it, the backend CLIENT_ORIGIN must be this site's origin so cookies and CORS work.
# VITE_API_BASE_URL=
